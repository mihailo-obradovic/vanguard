{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "baseBranchPatterns": ["master", "/^variant\\//"],
  "minimumReleaseAge": "1 day",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "addLabels": ["security"]
  },
  "packageRules": [
    {
      "description": "Back-end dependencies - PHP/Composer packages",
      "matchManagers": ["composer"],
      "matchBaseBranches": ["master"],
      "addLabels": ["back-end"],
      "semanticCommitType": "Dependency",
      "semanticCommitScope": "BE",
      "assignees": ["mihailo-obradovic"]
    },
    {
      "description": "Front-end dependencies - JavaScript/Node.js packages, general",
      "matchManagers": ["npm"],
      "matchBaseBranches": ["master"],
      "addLabels": ["front-end"],
      "semanticCommitType": "Dependency",
      "semanticCommitScope": "FE",
      "assignees": ["mihailo-obradovic"]
    },
    {
      "description": "On any variant branch, disable ALL dependency updates by default. Everything on master is ported to variants, so variants must only receive PRs for their own branch-specific deps (re-enabled explicitly below).",
      "matchBaseBranches": ["/^variant\\//"],
      "enabled": false
    },
    {
      "description": "Re-enable Vuetify's branch-specific front-end deps on variant/vuetify (not present on master).",
      "matchManagers": ["npm"],
      "matchBaseBranches": ["variant/vuetify"],
      "matchPackageNames": ["@mdi/js", "vite-plugin-vuetify", "vuetify"],
      "enabled": true,
      "addLabels": ["front-end", "vuetify"],
      "semanticCommitType": "Dependency",
      "semanticCommitScope": "FE - Vuetify",
      "assignees": ["mihailo-obradovic"]
    },
    {
      "description": "Re-enable Nuxt UI's branch-specific front-end deps on variant/nuxtui (not present on master).",
      "matchManagers": ["npm"],
      "matchBaseBranches": ["variant/nuxtui"],
      "matchPackageNames": ["@iconify-json/lucide", "@nuxt/ui", "tailwindcss"],
      "enabled": true,
      "addLabels": ["front-end", "nuxtui"],
      "semanticCommitType": "Dependency",
      "semanticCommitScope": "FE - NuxtUI",
      "assignees": ["mihailo-obradovic"]
    },
    {
      "description": "Only raise PRs for major/minor (x.y) releases; skip patch/hotfix (x.y.z) updates. Security patches still come through via vulnerabilityAlerts/osvVulnerabilityAlerts.",
      "matchUpdateTypes": ["patch"],
      "enabled": false
    }
  ],
  "ignorePaths": ["**/node_modules/**", "**/vendor/**"]
}
