{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "description": "Front-end dependencies - JavaScript/Node.js packages",
      "matchManagers": ["npm"],
      "matchFileNames": ["package.json", "pnpm-lock.yaml"],
      "addLabels": ["front-end"],
      "semanticCommitType": "Dependency ",
      "semanticCommitScope": "FE"
    },
    {
      "description": "Back-end dependencies - PHP/Composer packages",
      "matchManagers": ["composer"],
      "matchFileNames": ["composer.json", "composer.lock"],
      "addLabels": ["back-end"],
      "semanticCommitType": "Dependency ",
      "semanticCommitScope": "BE"
    }
  ],
  "ignorePaths": ["**/node_modules/**", "**/vendor/**"]
}
